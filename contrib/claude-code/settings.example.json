{
  "statusLine": {
    "type": "command",
    "command": "python3 ~/src/tokencur/contrib/claude-code/tokencur_hooks.py statusline",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/src/tokencur/contrib/claude-code/tokencur_hooks.py session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/src/tokencur/contrib/claude-code/tokencur_hooks.py session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
